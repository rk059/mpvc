RewriteEngine On
DirectoryIndex index.html

# Serve every page over HTTPS on the canonical www host.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.smartupvcbhuna.com%{REQUEST_URI} [L,R=301]

# Block internal, setup, and source-control files from public access.
RewriteRule (^|/)\.(git|github)(/|$) - [F,L]
<FilesMatch "\.(sql|md|yml|yaml|log|bak|example\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config|content)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
